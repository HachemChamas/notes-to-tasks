# Copy this file to `.env` (in this same folder) and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore, so your real values are never committed.
# All three parts of the app (Postgres, backend, frontend) read from that
# one `.env` file.

# ---------------------------------------------------------------------------
# Postgres (read by docker-compose.yml to create the database container)
# ---------------------------------------------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes_to_tasks
# Port on YOUR computer that maps to Postgres inside the container.
# Change it (e.g. to 5433) if you already have Postgres running on 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (read by backend/app/config.py)
# ---------------------------------------------------------------------------
# How the backend connects to Postgres. The user, password, port and
# database name MUST match the POSTGRES_* values above.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://notes:change-me@localhost:5432/notes_to_tasks

# The address the frontend runs on. The backend only accepts browser
# requests (CORS) from this origin.
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# AI that finds tasks in your notes. Keys are secret: they only live in your
# .env, never in the code or in a VITE_ variable.
# ---------------------------------------------------------------------------
# "gemini" (Google, has a free tier) or "claude" (Anthropic, paid).
AI_PROVIDER=gemini

# Gemini: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If a model stops working (Google retires old ones), pick another from
# https://ai.google.dev/gemini-api/docs/models and put its name here.
GEMINI_MODEL=gemini-3.5-flash
# Tried once when the main model is overloaded or out of free quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude: get a key at https://platform.claude.com (Settings -> API keys).
# Each extraction costs roughly a few US cents.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Frontend (read by Vite; only variables starting with VITE_ reach the browser)
# ---------------------------------------------------------------------------
# Where the frontend sends API requests. Never put secrets in VITE_ variables:
# anyone using the site can read them.
VITE_API_URL=http://localhost:8000
